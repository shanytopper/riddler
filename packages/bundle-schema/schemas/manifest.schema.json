{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riddles.invalid/schemas/bundle/v1/manifest.schema.json",
  "title": "Bundle manifest",
  "description": "Written by the bundle builder, never authored. Served by the delivery API so the app can show the download size before fetching, and included in the archive so the app can verify what it received.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "tenantId",
    "trackId",
    "trackVersion",
    "publishedAt",
    "languages",
    "files",
    "totalBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema version of both this manifest and the content.json it describes. The app refuses bundles newer than it understands and supports the previous version."
    },
    "bundleId": { "$ref": "#/$defs/uuid" },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "trackId": { "$ref": "#/$defs/uuid" },
    "trackVersion": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "media", "maps"],
      "properties": {
        "content": { "$ref": "#/$defs/contentFile" },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/mediaArtifact" }
        },
        "maps": {
          "type": "array",
          "items": {
            "oneOf": [{ "$ref": "#/$defs/tilesArtifact" }, { "$ref": "#/$defs/imageArtifact" }]
          },
          "description": "One entry per leg. Artifacts marked deferred are not in the archive and are fetched separately, typically the maps of later legs."
        },
        "fonts": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetFile" },
          "description": "Basemap glyph ranges (fonts/<stack>/<range>.pbf) for the track's languages. Absent when no leg uses a tiles map."
        },
        "sprites": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetFile" },
          "description": "Basemap sprite sheets and indexes (sprites/<flavor>.*) for both UI schemes."
        }
      }
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Size of the archive as downloaded, i.e. bundled artifacts only."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "file": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(content\\.json|media/[A-Za-z0-9._-]+|maps/[A-Za-z0-9._-]+)$"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "assetFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(fonts/[A-Za-z0-9 ._-]+/[0-9]+-[0-9]+\\.pbf|sprites/[A-Za-z0-9@._-]+)$"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contentFile": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/file" }],
      "properties": { "path": { "const": "content.json" } },
      "unevaluatedProperties": false
    },
    "mediaArtifact": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/file" }],
      "required": ["id", "mime", "widthPx", "heightPx"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "mime": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 }
      },
      "unevaluatedProperties": false
    },
    "tilesArtifact": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/file" }],
      "required": ["legId", "kind", "delivery", "bounds", "minZoom", "maxZoom"],
      "properties": {
        "legId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "pmtiles" },
        "delivery": { "enum": ["bundled", "deferred"] },
        "bounds": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "minZoom": { "type": "integer", "minimum": 0, "maximum": 22 },
        "maxZoom": { "type": "integer", "minimum": 0, "maximum": 22 }
      },
      "unevaluatedProperties": false
    },
    "imageArtifact": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/file" }],
      "required": ["legId", "kind", "delivery", "mime", "widthPx", "heightPx"],
      "properties": {
        "legId": { "$ref": "#/$defs/uuid" },
        "kind": { "const": "image" },
        "delivery": { "enum": ["bundled", "deferred"] },
        "mime": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 }
      },
      "unevaluatedProperties": false
    }
  }
}
