{
  "name": "@riddles/bundle-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Turns an authored track into a publishable bundle: validates, snapshots content, resizes media, extracts map tiles and basemap assets, and writes the archive with a hashed manifest.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "riddles-bundle": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "bundle": "node src/cli.ts"
  },
  "dependencies": {
    "@riddles/bundle-schema": "*",
    "fflate": "^0.8.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
