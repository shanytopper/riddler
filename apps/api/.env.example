# Copy to apps/api/.env (gitignored). Run hosted commands with: node --env-file=apps/api/.env apps/api/src/seed.ts
# The hosted database's EXTERNAL connection string (Render → riddles-db → Connect → External).
DATABASE_URL=
# The Render Postgres id (dpg-…), used by scripts/render-deploy.mjs to wire the service's DATABASE_URL.
RENDER_POSTGRES_ID=
# Optional: pin the Protomaps daily build (YYYYMMDD) the seed extracts tiles from; defaults to yesterday's.
# PROTOMAPS_BUILD=
